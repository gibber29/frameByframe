{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://framebyframe.onrender.com/api/:path*" },
    { "source": "/albumnesia/:path*", "destination": "/index.html" },
    { "source": "/badly-explained/:path*", "destination": "/index.html" },
    { "source": "/game/:path*", "destination": "/index.html" }
  ]
}
